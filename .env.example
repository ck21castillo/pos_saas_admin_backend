APP_ENV=local
APP_DEBUG=1

# DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=bersano_control
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bersano_control
# Control: en produccion usar bersano_admin_ejecucion.
DB_USER=postgres
DB_PASSWORD=tu_password
DB_PASS=tu_password
DB_PERSISTENT=0

DB_TENANT_HOST=
DB_TENANT_PORT=
DB_TENANT_USER=
DB_TENANT_PASSWORD=
# Produccion: DB_TENANT_USER y DB_TENANT_PASSWORD son obligatorios para
# conexiones tenant. Usar bersano_admin_ejecucion; no usar DB_PROVISION_* aqui.

JWT_SECRET=CAMBIA_ESTO_LARGO_Y_SEGURO
JWT_ISSUER=pos_admin_api
JWT_TTL_SECONDS=900

ADMIN_OTP_ENABLE=false
ADMIN_OTP_TTL=300
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_RESEND_MAX=3
ADMIN_OTP_COOKIE_NAME=admin_otp

# En produccion debe ser true. El arranque HTTP lo exige.
ADMIN_LOGIN_RATE_LIMIT_ENABLED=false
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_LOGIN_RATE_LIMIT_EMAIL_IP_MAX=8
ADMIN_LOGIN_RATE_LIMIT_IP_MAX=30

ADMIN_REAUTH_COOKIE_NAME=admin_reauth
ADMIN_REAUTH_TTL_SECONDS=28800
ADMIN_REAUTH_RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_REAUTH_RATE_LIMIT_ADMIN_IP_MAX=5
ADMIN_REAUTH_RATE_LIMIT_IP_MAX=20

COOKIE_SECURE=0
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Limites de entrada HTTP. El proxy web debe aplicar los mismos limites antes
# de llegar a PHP; ver docs/seguridad-admin.md.
ADMIN_JSON_MAX_BYTES=1048576
LANDING_ANALYTICS_RATE_LIMIT_ENABLED=true
LANDING_ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=60
LANDING_ANALYTICS_VISITOR_MAX=6
LANDING_ANALYTICS_IP_MAX=30
# Solo declarar proxies que realmente controlamos. Entonces se honra X-Forwarded-For.
TRUSTED_PROXY_IPS=
# La inspeccion profunda se realiza desde el worker, no desde HTTP por defecto.
TENANT_HEALTH_DEEP_HTTP_ENABLED=false

# Origenes permitidos para CORS separados por coma
# Ejemplo: https://bersanopos.com,https://www.bersanopos.com
CORS_ALLOWED_ORIGINS=

APP_NAME="Bersano POS"
ONBOARDING_REGISTER_URL=https://bersanopos.com/#/register-company

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME="Bersano POS"

